# Copy to .env for local overrides (docker-compose.yml already sets sane
# defaults for the containerized services — you usually don't need this
# unless running the API/worker outside Docker).

ENVIRONMENT=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse

REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=30

AWS_REGION=us-west-2
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_URL=http://localhost:4566/000000000000/pulse-events
SQS_DLQ_URL=http://localhost:4566/000000000000/pulse-events-dlq
S3_BUCKET=pulse-raw-events

RATE_LIMIT_PER_MINUTE=600
CORS_ALLOW_ORIGINS=["http://localhost:5173"]
